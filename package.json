{
  "name": "libplate",
  "version": "0.1.0",
  "description": "Format validation, parsing and structured analysis of European vehicle registration plates.",
  "keywords": [
    "license-plate",
    "number-plate",
    "matricula",
    "kennzeichen",
    "vehicle-registration",
    "validation",
    "europe"
  ],
  "license": "MIT",
  "author": "Brais Blanco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BraisBlanco/libplate.git"
  },
  "homepage": "https://github.com/BraisBlanco/libplate#readme",
  "bugs": {
    "url": "https://github.com/BraisBlanco/libplate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "metadata",
    "schema",
    "docs/SOURCES.md"
  ],
  "scripts": {
    "metadata": "node scripts/build-metadata.mjs",
    "prebuild": "npm run metadata",
    "build": "tsup",
    "prepack": "npm run build",
    "pretypecheck": "npm run metadata",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run metadata",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "npm run metadata && vitest run --coverage",
    "prelint": "npm run metadata",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "npm run metadata && knip",
    "mutation": "npm run metadata && stryker run",
    "attw": "attw --pack .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run knip && npm run coverage && npm run attw"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.15.0",
    "knip": "^5.88.1",
    "prettier": "^3.9.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  },
  "engines": {
    "node": ">=22"
  }
}
