{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://libplate.dev/schema/plate-metadata.schema.json",
  "title": "libplate plate scheme",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "country",
    "name",
    "registrationType",
    "vehicleInference",
    "normalization",
    "segments",
    "formats",
    "sources",
    "examples"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "name": { "type": "string", "minLength": 1 },
    "registrationType": {
      "enum": [
        "ORDINARY",
        "TEMPORARY_PRIVATE",
        "TEMPORARY_COMPANY",
        "TEMPORARY_WW",
        "PROFESSIONAL_TEMPORARY",
        "DIPLOMATIC",
        "CONSULAR",
        "INTERNATIONAL_ORGANIZATION",
        "DIPLOMATIC_STAFF",
        "TOURIST",
        "HISTORICAL",
        "EXPORT",
        "STATE_OR_MILITARY",
        "SPECIAL",
        "UNKNOWN"
      ]
    },
    "legacySeries": { "type": "boolean" },
    "validFrom": { "type": "string", "format": "date" },
    "validTo": { "type": "string", "format": "date" },
    "vehicleInference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": {
          "enum": [
            "DETERMINISTIC",
            "CATEGORY_ONLY",
            "VISUAL_EVIDENCE_REQUIRED",
            "REGISTRY_REQUIRED",
            "NOT_INFERABLE"
          ]
        },
        "category": { "$ref": "#/$defs/vehicleCategory" },
        "possibleCategories": {
          "type": "array",
          "items": { "$ref": "#/$defs/vehicleCategory" }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": {
                "enum": [
                  "PREFIX",
                  "PATTERN",
                  "COUNTRY_HINT",
                  "EU_COUNTRY_CODE",
                  "DATE_RANGE"
                ]
              },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uppercase", "acceptedSeparators"],
      "properties": {
        "uppercase": { "type": "boolean" },
        "acceptedSeparators": {
          "type": "array",
          "items": { "type": "string", "maxLength": 1 }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "value"],
            "properties": {
              "name": { "type": "string" },
              "type": { "const": "LITERAL" },
              "value": { "type": "string", "pattern": "^[A-Z0-9]+$" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "const": "DIGITS" },
              "length": { "type": "integer", "minimum": 1 },
              "minLength": { "type": "integer", "minimum": 1 },
              "maxLength": { "type": "integer", "minimum": 1 },
              "noLeadingZero": { "type": "boolean" }
            },
            "allOf": [{ "$ref": "#/$defs/lengthSpec" }]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "characters"],
            "properties": {
              "name": { "type": "string" },
              "type": { "const": "CHARSET" },
              "length": { "type": "integer", "minimum": 1 },
              "minLength": { "type": "integer", "minimum": 1 },
              "maxLength": { "type": "integer", "minimum": 1 },
              "characters": { "type": "string", "pattern": "^[A-Z0-9]+$" }
            },
            "allOf": [{ "$ref": "#/$defs/lengthSpec" }]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "const": "LETTERS" },
              "length": { "type": "integer", "minimum": 1 },
              "minLength": { "type": "integer", "minimum": 1 },
              "maxLength": { "type": "integer", "minimum": 1 },
              "excluded": {
                "type": "array",
                "items": { "type": "string", "pattern": "^[A-Z]$" }
              },
              "excludedValues": {
                "type": "array",
                "items": { "type": "string", "pattern": "^[A-Z]+$" }
              }
            },
            "allOf": [{ "$ref": "#/$defs/lengthSpec" }]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "table"],
            "properties": {
              "name": { "type": "string" },
              "type": { "const": "TABLE" },
              "table": { "type": "string", "pattern": "^[a-z0-9-]+$" }
            }
          }
        ]
      }
    },
    "lengthRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anyOf"],
      "properties": {
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["segments", "max"],
            "properties": {
              "segments": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "max": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "formats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["national", "compact"],
      "properties": {
        "national": { "type": "string" },
        "compact": { "type": "string" }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "foreground": { "$ref": "#/$defs/color" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "section": { "type": "string" }
        }
      }
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "invalid"],
      "properties": {
        "valid": { "type": "array", "items": { "type": "string" } },
        "invalid": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "lengthSpec": {
      "oneOf": [
        {
          "required": ["length"],
          "not": {
            "anyOf": [{ "required": ["minLength"] }, { "required": ["maxLength"] }]
          }
        },
        {
          "required": ["minLength", "maxLength"],
          "not": { "required": ["length"] }
        }
      ]
    },
    "color": {
      "enum": ["WHITE", "BLACK", "RED", "BLUE", "GREEN", "YELLOW", "PINK"]
    },
    "vehicleCategory": {
      "enum": [
        "PASSENGER_CAR",
        "MOTORCYCLE",
        "MOPED_OR_MOTOR_CYCLE",
        "TRICYCLE",
        "QUADRICYCLE",
        "VAN",
        "TRUCK",
        "BUS",
        "TRAILER",
        "SEMITRAILER",
        "TRAILER_OR_SEMITRAILER",
        "SPECIAL_VEHICLE",
        "AGRICULTURAL_VEHICLE",
        "INDUSTRIAL_MACHINE",
        "UNKNOWN_MOTOR_VEHICLE",
        "OTHER"
      ]
    }
  }
}
